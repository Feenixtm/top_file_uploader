<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link rel="stylesheet" href="/css/output.css">
</head>
<body>
    <header class="flex justify-between items-center px-4 md:px-8 py-2 bg-blue-200">
        <div class="flex gap-4">
            <a href="/">Home</a>
            <a href="/test">Test</a>
        </div>
        

        <% if (locals.user) { %>
            <a href="/log-out">Log Out</a>
        <% } else { %>
            <div class="flex gap-4">
                <a href="/sign-up">Sign Up</a>
                <a href="/login">Login</a>
            </div>
        <% } %> 
    </header>

    <main class="flex flex-col gap-4 min-h-[calc(100vh-2.5rem)] p-4 md:px-8 bg-blue-100">

        <% if (locals.user) { %>
            <p class="italic text-[1.5rem]">Welcome back <%= user.username %></p>

            <div class="flex flex-col gap-4 p-4 bg-blue-200">
                
                <% if (locals.folder) { %>
                    <div class="flex gap-2 items-center">
                        <svg width="20px" height="20px" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M0 1H6L9 4H16V14H0V1Z" fill="#000000"/>
                        </svg>

                        <h1>
                            /
                            <% if (locals.parentFolderName) { %>
                                <a href="/">
                                    <%= parentFolderName %>
                                </a>
                                /
                                <a href="/folders/<%= parentFolderName %>/<%= folder.name %>">
                                    <%= folder.name %>
                                </a>
                            <% } else { %>
                                <%= folder.name %>
                            <% } %> 
                        </h1>
                    </div>
                <% } %>

                <div class="flex flex-wrap gap-2 p-4 bg-blue-300">
                    <% if (folder && folder.children) { %>
                        <% folder.children.map((child, index) => { %>
                            <div class="flex flex-col justify-center items-center px-4 pt-2 pb-4 max-w-[7.5rem] bg-blue-400">
                                <div class="folder-svg-div">
                                    <svg width="78px" height="78px" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M0 1H6L9 4H16V14H0V1Z" fill="#000000"/>
                                    </svg>
                                </div>
                                <a href="/folders/<%= folder.name %>/<%= child.name %>" class="text-center text-wrap text-[0.75rem] truncate"><%= child.name %></a>
                            </div>
                        <% }) %>
                    <% } %>

                    <% if (folder && folder.files) { %>
                        <% folder.files.map((file, index) => { %>
                            <div class="flex flex-col justify-center items-center px-2 pt-2 pb-4 bg-blue-400">
                                <div class="file-img-div">
                                    <% if (locals.parentFolderName) { %>
                                        <img class="file-img" src="../../<%= file.path %>" alt="">
                                    <% } else { %>
                                        <img class="file-img" src="../<%= file.path %>" alt="">
                                    <% } %> 
                                </div>
                                <a href="/files/<%= file.id %>" class="text-[0.75rem]">View Details</a>
                            </div>
                        <% }) %>
                    <% } %>
                </div>

            </div>

            <div class="flex flex-col gap-1 p-4 bg-blue-200">
                <h2>Upload File to '<%= folder.name %>'</h2>
                <div class="flex justify-between">
                    <form action="/api/upload" method="POST" enctype="multipart/form-data">
                        <input type="file" name="avatar" required class="file-input border px-4 py-1 w-fit">
                        <input type="hidden" name="cuid" value="<%= folder.id %>">
                        <button class="border" type="submit" name="folderId" value="<% folder.id %>">Upload File</button>
                    </form>
                    
                    <button id="toggle-hidden-div-btn" class="w-fit">Add Folder +</button>
                </div>
            </div>

            <div id="hidden-div" class="p-4 bg-blue-200" style="display: none;">
                <form class="p-4 border flex gap-2 w-fit" action="/api/create-folder" method="POST">
                    <div class="flex gap-2 items-center">
                        <label for="">Folder Name:</label>
                        <input type="hidden" name="userId" value="<%= user.id %>">
                        <input type="text" name="folderName" class="py-1">
                    </div>

                    <button type="submit" name="rootFolderCUID" value="<%= folder.id %>">Create Folder</button>
                </form>
            </div>

        <% } else { %>
            <h1>Please Log In</h1>
        <% } %>
    </main>
    
    <script>
        const btn = document.querySelector("#toggle-hidden-div-btn");
        const hiddenDiv = document.querySelector("#hidden-div");
        btn.addEventListener("click", function() {
            if (hiddenDiv.style.display === "none") {
                hiddenDiv.style.display = "block";
            } else {
                hiddenDiv.style.display = "none";
            }
        })
    </script>
</body>
</html>